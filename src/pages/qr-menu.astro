---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";
import SITE from "../consts";

const pagePath = "/qr-menu";
const pageUrl = new URL(pagePath, SITE.url).toString();
const homeUrl = new URL("/", SITE.url).toString();
---

<BaseLayout
    title="QR Menü – SAKU Studios"
    description="Restoran ve kafeler için modern QR menü çözümü. Anlık güncelleme, çoklu dil, kolay yönetim."
    canonical={pagePath}
    lang="tr"
    jsonLd={[
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            url: pageUrl,
            name: "QR Menü — SAKU Studios",
            inLanguage: ["tr", "en"],
            isPartOf: { "@id": `${SITE.url}/#website` },
            about: { "@id": `${SITE.url}/#organization` },
            description:
                "Restoran ve kafeler için modern, yönetimi kolay QR menü çözümü.",
        },
        {
            "@type": "Product",
            "@id": `${pageUrl}#product`,
            name: "SAKU QR Menü",
            description:
                "Restoran, kafe ve işletmeler için modern QR menü çözümü. Anlık güncelleme, çoklu dil, markaya özel tasarım.",
            brand: { "@id": `${SITE.url}/#organization` },
            category: "SoftwareApplication",
        },
        {
            "@type": "BreadcrumbList",
            "@id": `${pageUrl}#breadcrumb`,
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Ana Sayfa",
                    item: homeUrl,
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "QR Menü",
                    item: pageUrl,
                },
            ],
        },
    ]}
>
    <Header />

    <section class="hero-dark">
        <div class="container hero-inner">
            <div class="breadcrumb">
                <a href="/" id="t-qr_breadcrumb_home">Ana Sayfa</a>
                <span>›</span>
                <span id="t-qr_breadcrumb_here">QR Menü</span>
            </div>
            <span class="hero-badge" id="t-qr_badge">Ürün</span>
            <h1 class="hero-title" id="t-qr_title">QR Menü</h1>
            <p class="hero-sub" id="t-qr_sub">
                Restoran, kafe ve işletmeler için modern QR menü çözümü. Hızlı,
                yönetimi kolay ve markanıza uygun.
            </p>
            <div class="hero-ctas">
                <a href="#contact" class="btn btn-primary">
                    <span id="t-qr_cta">Demo / İletişim</span>
                </a>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-head">
                <h2 id="t-qr_features_head">Öne Çıkan Özellikler</h2>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M21 12a9 9 0 1 1-9-9"></path>
                            <path d="M21 3v6h-6"></path>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat1_title">
                        Anlık Güncelleme
                    </h3>
                    <p class="feature-desc" id="t-qr_feat1_desc">
                        Menü değişikliklerini anında yayınlayın; QR kodu
                        değiştirmeden içeriği güncelleyin.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M2 12h20"></path>
                            <path
                                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat2_title">
                        Çoklu Dil
                    </h3>
                    <p class="feature-desc" id="t-qr_feat2_desc">
                        Türkçe, İngilizce ve diğer dillerde menü sunun; turist
                        müşterilerinize kolaylık sağlayın.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"
                            ></rect>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat3_title">
                        Kategori & Ürün Yönetimi
                    </h3>
                    <p class="feature-desc" id="t-qr_feat3_desc">
                        Kategoriler, ürünler, fiyatlar ve görselleri kolay bir
                        panelden yönetin.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="13.5" cy="6.5" r="2.5"></circle>
                            <circle cx="19" cy="13" r="2.5"></circle>
                            <circle cx="6" cy="12" r="2.5"></circle>
                            <circle cx="10" cy="20" r="2.5"></circle>
                            <path
                                d="M12 22a10 10 0 1 1 10-10c0 1.66-.63 2.5-2 2.5"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat4_title">
                        Markaya Özel Tasarım
                    </h3>
                    <p class="feature-desc" id="t-qr_feat4_desc">
                        Renk, logo ve tipografi ile menüyü markanıza uygun hale
                        getirin.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect width="14" height="20" x="5" y="2" rx="2"
                            ></rect>
                            <path d="M12 18h.01"></path>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat5_title">
                        Mobil Öncelikli
                    </h3>
                    <p class="feature-desc" id="t-qr_feat5_desc">
                        Müşteri deneyimi için hızlı yüklenen, mobilde mükemmel
                        çalışan modern arayüz.
                    </p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="feature-title" id="t-qr_feat6_title">
                        Güvenli Altyapı
                    </h3>
                    <p class="feature-desc" id="t-qr_feat6_desc">
                        Supabase tabanlı güvenli veri altyapısı ve güvenilir
                        bulut sunucular.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" style="background: var(--surface-alt);">
        <div class="container">
            <div class="section-head">
                <h2 id="t-qr_preview_head">Önizleme</h2>
                <p class="muted" id="t-qr_preview_desc">
                    Ekran görüntüleri yakında burada olacak.
                </p>
            </div>
            <div class="preview-placeholder">
                <div class="preview-slot">1</div>
                <div class="preview-slot">2</div>
                <div class="preview-slot">3</div>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-head">
                <h2 id="t-qr_tech_head">Teknoloji</h2>
                <p class="muted" id="t-qr_tech_desc">
                    Modern web teknolojileri üzerine inşa edilmiştir.
                </p>
            </div>
            <div class="tech-chips">
                <span class="tech-chip">Supabase</span>
                <span class="tech-chip">PostgreSQL</span>
                <span class="tech-chip">Ubuntu</span>
                <span class="tech-chip">React</span>
                <span class="tech-chip">TypeScript</span>
                <span class="tech-chip">Edge Functions</span>
            </div>
        </div>
    </section>

    <ContactSection />

    <Footer />

    <script>
        import { i18n } from "../lib/i18n";
        import { detectLang, applyLang } from "../utils/lang";

        const initial = detectLang();
        applyLang(initial, i18n[initial]);

        document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const lang = btn.dataset.lang === "en" ? "en" : "tr";
                applyLang(lang, i18n[lang]);
            });
        });
    </script>
</BaseLayout>
