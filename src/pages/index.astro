---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactSection from "../components/ContactSection.astro";
import SITE from "../consts";

const pagePath = "/";
const pageUrl = new URL(pagePath, SITE.url).toString();
const qrMenuUrl = new URL("/qr-menu", SITE.url).toString();
---

<BaseLayout
    title="SAKU Studios – QR Menü ve Dijital Çözümler"
    description="SAKU Studios — restoran, kafe ve işletmeler için QR menü, dijital menü ve özel teknoloji çözümleri. Hızlı kurulum, kolay yönetim, markanıza özel tasarım."
    canonical={pagePath}
    lang="tr"
    jsonLd={[
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            url: pageUrl,
            name: "SAKU Studios – QR Menü ve Dijital Çözümler",
            inLanguage: ["tr", "en"],
            isPartOf: { "@id": `${SITE.url}/#website` },
            about: { "@id": `${SITE.url}/#organization` },
            description:
                "SAKU Studios — restoran, kafe ve işletmeler için QR menü, dijital menü ve özel teknoloji çözümleri.",
            primaryImageOfPage: {
                "@type": "ImageObject",
                url: new URL(SITE.defaultOgImage, SITE.url).toString(),
            },
        },
        {
            "@type": "Service",
            "@id": `${qrMenuUrl}#service`,
            name: "QR Menü Sistemi",
            serviceType: "QR Menu System",
            url: qrMenuUrl,
            provider: { "@id": `${SITE.url}/#organization` },
            areaServed: { "@type": "Country", name: "Türkiye" },
            description:
                "Restoran ve kafeler için modern, yönetimi kolay QR menü sistemi. Anlık güncelleme, çoklu dil, markaya özel tasarım.",
            offers: {
                "@type": "Offer",
                priceCurrency: "TRY",
                availability: "https://schema.org/InStock",
                url: qrMenuUrl,
            },
        },
        {
            "@type": "ItemList",
            "@id": `${pageUrl}#products`,
            name: "Ürünler & Çözümler",
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "QR Menü Sistemi",
                    url: qrMenuUrl,
                },
            ],
        },
    ]}
>
    <Header />

    <section class="hero-dark">
        <div class="container hero-inner">
            <span class="hero-badge" id="t-hero_badge">Dijital Çözümler</span>
            <h1 class="hero-title" id="t-hero_title">
                Dijital çözümlerle işinizi büyütün
            </h1>
            <p class="hero-sub" id="t-hero_sub">
                SAKU Studios; restoran, kafe ve işletmeler için QR menü,
                dijital menü ve özel teknoloji çözümleri geliştirir.
            </p>
            <div class="hero-ctas">
                <a href="#products" class="btn btn-primary">
                    <span id="t-hero_cta_primary">Ürünleri Gör</span>
                </a>
                <a href="#contact" class="btn btn-ghost-dark">
                    <span id="t-hero_cta_secondary">İletişime Geç</span>
                </a>
            </div>
        </div>
    </section>

    <section class="section" id="products">
        <div class="container">
            <div class="section-head">
                <h2 id="t-products_head">Ürünler & Çözümler</h2>
                <p class="muted" id="t-products_desc">
                    İşletmenize değer katan, markanıza özel dijital çözümler.
                </p>
            </div>

            <div class="products-grid">
                <a
                    href="/qr-menu"
                    class="product-card"
                    aria-label="QR Menü Sistemi detay sayfası"
                >
                    <div class="product-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"
                            ></rect>
                            <path d="M14 14h3v3h-3z"></path>
                            <path d="M20 14v3"></path>
                            <path d="M14 20h3"></path>
                            <path d="M20 20h1"></path>
                        </svg>
                    </div>
                    <h3 class="product-title" id="t-products_qrmenu_title">
                        QR Menü Sistemi
                    </h3>
                    <p class="product-desc" id="t-products_qrmenu_desc">
                        Restoran ve kafeler için modern dijital menü. Anlık
                        güncelleme, çoklu dil, markaya özel tasarım.
                    </p>
                    <span class="product-cta" id="t-products_qrmenu_cta">
                        Detayları Gör →
                    </span>
                </a>

                <div
                    class="product-card is-soon"
                    aria-label="Yeni ürün yakında"
                >
                    <span class="product-badge" id="t-products_soon_badge">
                        Yakında
                    </span>
                    <div class="product-icon" aria-hidden="true">
                        <svg
                            viewBox="0 0 24 24"
                            width="24"
                            height="24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M12 5v14"></path>
                            <path d="M5 12h14"></path>
                        </svg>
                    </div>
                    <h3 class="product-title" id="t-products_soon_title">
                        Yeni Ürün
                    </h3>
                    <p class="product-desc" id="t-products_soon_desc">
                        Yeni çözümler üzerinde çalışıyoruz. Yakında burada
                        olacak.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="about">
        <div class="container">
            <div class="section-head">
                <h2 id="t-about_head">Hakkımda</h2>
            </div>
            <div class="about-card">
                <p class="muted" id="t-about_body">
                    SAKU Studios hakkında kısa bir tanıtım yazısı yakında burada
                    olacak.
                </p>
            </div>
        </div>
    </section>

    <ContactSection />

    <Footer />

    <script>
        import { i18n } from "../lib/i18n";
        import { detectLang, applyLang } from "../utils/lang";

        const initial = detectLang();
        applyLang(initial, i18n[initial]);

        document.querySelectorAll<HTMLButtonElement>(".lang-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                const lang = btn.dataset.lang === "en" ? "en" : "tr";
                applyLang(lang, i18n[lang]);
            });
        });
    </script>
</BaseLayout>
